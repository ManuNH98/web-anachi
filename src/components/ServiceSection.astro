---
// Importa los iconos SVG directamente como cadenas o compónelos
// En este caso, para simplificar, usaremos los SVG completos en el array.

const services = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" style="color: var(--color-accent-orange);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
             <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
           </svg>`,
    title: 'Declaraciones Aduaneras',
    description: 'Gestionamos y presentamos todas tus declaraciones aduaneras de importación, exportación y tránsito (DUAs), asegurando el cumplimiento normativo y la agilidad en la liberación de tu mercancía.'
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" style="color: var(--color-accent-orange);" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m5.231 13.481L15 17.25m-4.5-15H5.625c-.621 0-1.125.504-1.125 1.125v16.5c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Zm3.75 11.625a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
          </svg>`,
    title: 'Asistencia en Inspecciones',
    description: 'Coordinamos eficazmente con todas las autoridades competentes y asistimos en tu representación durante las inspecciones físicas, garantizando un proceso fluido y sin contratiempos.'
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" style="color: var(--color-accent-orange);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
             <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
           </svg>`,
    title: 'Consultoría Experta',
    description: 'Te ofrecemos asesoramiento completo sobre normativa aduanera, fiscal y tributaria, optimizando tus operaciones y la gestión de garantías y regímenes aduaneros especiales.'
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" style="color: var(--color-accent-orange);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
             <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
           </svg>`,
    title: 'Estatus OEA',
    description: 'Como Operador Económico Autorizado (OEA), somos un agente de confianza reconocido internacionalmente, lo que nos permite simplificar procedimientos aduaneros y agilizar tu cadena de suministro.'
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" style="color: var(--color-accent-orange);" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
          </svg>`,
    title: 'Gestión Paraduanera',
    description: 'Tramitamos todos los permisos necesarios con Sanidad Exterior, Animal, Vegetal, SOIVRE, Farmacia y otros organismos, vital para la importación/exportación de alimentos y bebidas.'
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" style="color: var(--color-accent-orange);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
             <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
           </svg>`,
    title: 'Certificados de Origen',
    description: 'Tramitamos certificados como EUR-1 y ATR para que puedas beneficiarte de las preferencias arancelarias y reducir los costes de importación/exportación de tus mercancías.'
  }
];
---

<section id="services" class="relative overflow-hidden py-24 px-4" style="background-color: var(--color-background-light);">
  <div class="absolute right-0 top-0 h-72 w-72 translate-x-1/3 rounded-full bg-orange-100 blur-3xl"></div>
  <div class="container mx-auto text-center">
    <p class="section-eyebrow justify-center">Servicios</p>
    <h2 class="text-4xl sm:text-5xl font-bold mb-4">Soluciones Aduaneras Integrales para tu Negocio</h2>
    <p class="max-w-3xl mx-auto text-lg sm:text-xl mb-12" style="color: var(--color-text-muted);">
      Ofrecemos un catálogo completo de servicios para que tu mercancía se mueva sin interrupciones. Desde la gestión documental hasta la asesoría estratégica, estamos a tu lado en cada paso.
    </p>

    {/* Contenedor de las tarjetas de servicio */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 gap-8">
      {services.map(service => (
        <div class="surface-card group relative overflow-hidden rounded-3xl p-8 text-left flex flex-col transition duration-300 hover:-translate-y-2 hover:shadow-2xl">
          <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-orange-500 to-orange-300 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
          <div class="mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-orange-50" set:html={service.icon}></div>
          <h3 class="text-2xl font-bold mb-3">{service.title}</h3>
          <p class="flex-grow leading-7" style="color: var(--color-text-muted);">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
