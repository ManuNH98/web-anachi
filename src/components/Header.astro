---
import logoAnachi from '../assets/logo.png';
---

<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/90 py-3 shadow-sm backdrop-blur-xl">
  <div class="container mx-auto px-4 flex justify-between items-center">
    <a href="/">
      <img src={logoAnachi.src} alt="Logo de Aduanas Anachi" width="160" />
    </a>

    <nav class="hidden md:block">
      <ul class="flex space-x-8">
        <li><a href="#services" class="text-base font-bold text-slate-700 transition-colors duration-200 hover:text-orange-500 hover:no-underline">Servicios</a></li>
        <li><a href="#about-us" class="text-base font-bold text-slate-700 transition-colors duration-200 hover:text-orange-500 hover:no-underline">Quiénes Somos</a></li>
        <li><a href="#contact" class="text-base font-bold text-slate-700 transition-colors duration-200 hover:text-orange-500 hover:no-underline">Contacto</a></li>
      </ul>
    </nav>

    <a href="#contact" class="btn-primary hidden md:block text-base px-6 py-2">
      Habla con un Experto
    </a>

    <button id="menu-button" class="md:hidden rounded-full border border-slate-200 bg-white p-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-500" aria-label="Abrir menú">
      <svg id="menu-icon-open" class="h-8 w-8 text-primary-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="menu-icon-close" class="h-8 w-8 text-primary-dark hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="fixed inset-y-0 right-0 w-72 p-6 transform translate-x-full transition-transform duration-300 ease-in-out md:hidden z-50 shadow-2xl" style="background-color: var(--color-white);">
    <div class="flex justify-end mb-8">
      <button id="close-menu-button" class="p-2 rounded-md focus:outline-none focus:ring-2 focus:ring-accent-orange">
        <svg class="h-8 w-8 text-primary-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <nav class="flex flex-col space-y-6 text-xl">
      <a href="#services" class="text-primary-dark hover:text-accent-orange transition-colors duration-200" id="mobile-nav-servicios">Servicios</a>
      <a href="#about-us" class="text-primary-dark hover:text-accent-orange transition-colors duration-200" id="mobile-nav-quienes-somos">Quiénes Somos</a>
      <a href="#contact" class="text-primary-dark hover:text-accent-orange transition-colors duration-200" id="mobile-nav-contacto">Contacto</a>
      <div class="pt-8">
        <a href="#contact" class="btn-primary w-full text-center text-lg py-3">
          Habla con un Experto
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  // Script para manejar el menú móvil
  const menuButton = document.getElementById('menu-button');
  const closeMenuButton = document.getElementById('close-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIconOpen = document.getElementById('menu-icon-open');
  const menuIconClose = document.getElementById('menu-icon-close');
  const mobileNavLinks = mobileMenu.querySelectorAll('a'); // Selecciona todos los enlaces dentro del menú móvil

  function toggleMenu() {
    mobileMenu.classList.toggle('translate-x-full'); // Desliza el menú
    menuIconOpen.classList.toggle('hidden'); // Alterna icono de hamburguesa
    menuIconClose.classList.toggle('hidden'); // Alterna icono de cierre
    document.body.classList.toggle('overflow-hidden'); // Evita scroll en el body cuando el menú está abierto
  }

  menuButton.addEventListener('click', toggleMenu);
  closeMenuButton.addEventListener('click', toggleMenu);

  // Cierra el menú cuando se hace clic en un enlace del menú móvil
  mobileNavLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (!mobileMenu.classList.contains('translate-x-full')) { // Si el menú está abierto
        toggleMenu(); // Cierra el menú
      }
    });
  });

  // Opcional: Cierra el menú si se redimensiona a desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768 && !mobileMenu.classList.contains('translate-x-full')) {
      toggleMenu();
    }
  });

</script>

<style is:global>
  /* Asegura que el body tenga un overflow oculto cuando el menú esté abierto */
  body.overflow-hidden {
    overflow: hidden;
  }
</style>
