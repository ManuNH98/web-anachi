---
---

<section 
  class="relative overflow-hidden text-white py-16 px-4" 
  style={`background-color: var(--color-primary-dark);`}
>
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-orange-400/80 to-transparent"></div>
  <div class="absolute -left-24 top-10 h-64 w-64 rounded-full bg-orange-500/10 blur-3xl"></div>
  <div class="container mx-auto text-center">
    {/* Contadores de Éxito */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      {/* Contador 1: Años de Experiencia */}
      <div class="rounded-3xl border border-white/10 bg-white/5 p-6 flex flex-col items-center justify-center backdrop-blur">
        <p class="text-6xl font-black mb-2" style={`color: var(--color-accent-orange);`}>30+</p>
        <p class="text-xl">Años de Experiencia</p>
      </div>

      {/* Contador 2: Clientes Satisfechos (Valor ilustrativo) */}
      <div class="rounded-3xl border border-white/10 bg-white/5 p-6 flex flex-col items-center justify-center backdrop-blur">
        <p class="text-6xl font-black mb-2" style={`color: var(--color-accent-orange);`}>50+</p>
        <p class="text-xl">Clientes Satisfechos</p>
      </div>

      {/* Contador 3: Operaciones Gestionadas (Valor ilustrativo) */}
      <div class="rounded-3xl border border-white/10 bg-white/5 p-6 flex flex-col items-center justify-center backdrop-blur">
        <p class="text-6xl font-black mb-2" style={`color: var(--color-accent-orange);`}>3000+</p>
        <p class="text-xl">Despachos al Año</p>
      </div>
    </div>

    {/* Mensaje de Capacidad */}
    <div class="max-w-3xl mx-auto">
      <p class="section-eyebrow justify-center">Confianza operativa</p>
      <h2 class="text-3xl sm:text-4xl font-bold leading-tight mb-4" style="color: var(--color-white);">
        Preparados para cualquier desafío aduanero.
      </h2>
      <p class="text-lg sm:text-xl">
        Desde la gestión de importaciones y exportaciones estándar hasta los casos más complejos y urgentes, nuestro equipo garantiza la liberación de tu mercancía a tiempo y sin contratiempos.
      </p>
    </div>
  </div>
</section>
