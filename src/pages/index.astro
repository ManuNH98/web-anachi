---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import SocialSection from '../components/SocialSection.astro';
import ServiceSection from '../components/ServiceSection.astro';
import AboutSection from '../components/AboutSection.astro';
import ContactSection from '../components/ContactSection.astro';
---

<Layout
  title="Aduanas Anachi | Expertos en Gestión Aduanera"
  description="Agencia de aduanas con más de 30 años de experiencia en Las Palmas, especializada en despachos de alimentación, bebidas y mercancías del REA (Régimen Específico de Abastecimiento)."
  ogTitle="Aduanas Anachi: Tu Socio Estratégico en Canarias | Gestión Aduanera Eficaz"
  ogDescription="Descubre cómo Aduanas Anachi, con más de 30 años de experiencia, agiliza tus operaciones de importación y exportación en Las Palmas. Asesoría experta y trato familiar."
>
  <Header />
  <main>
    <HeroSection />
	<SocialSection />
	<ServiceSection />
	<AboutSection />
	<ContactSection />
  </main>
</Layout>